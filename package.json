{
  "name": "clinixstudy",
  "productName": "ClinixStudy",
  "version": "3.37.0",
  "description": "ClinixStudy — NCLEX-RN study app (Android via Capacitor, Windows via Electron)",
  "author": "MOSTAFA HAMMAD",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node --import ./tests/register.mjs --test tests/engine.test.mjs tests/chat.test.mjs tests/words.test.mjs tests/photos.test.mjs tests/mistakes.test.mjs tests/latency.test.mjs tests/gateway.test.mjs tests/paid.test.mjs tests/quota.test.mjs tests/free.test.mjs tests/keyring.test.mjs tests/reuse.test.mjs tests/speed.test.mjs tests/guard.test.mjs",
    "sim:free": "node --no-warnings --import ./tests/register.mjs tests/sim/free-day.mjs ."
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.3",
    "@fontsource/cairo": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.clinixstudy.desktop",
    "productName": "ClinixStudy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon-only.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-only.png"
    },
    "nsis": {
      "artifactName": "ClinixStudy-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "ClinixStudy-Portable-${version}.exe"
    }
  }
}
