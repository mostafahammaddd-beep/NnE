{
  "name": "nclex-rn",
  "productName": "NCLEX-RN",
  "version": "3.26.0",
  "description": "NCLEX-RN study app (Android via Capacitor, Windows via Electron)",
  "author": "MOSTAFA HAMMAD",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node --import ./tests/register.mjs --test tests/engine.test.mjs tests/chat.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@fontsource/cairo": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.nclexrn.desktop",
    "productName": "NCLEX-RN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon-only.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-only.png"
    },
    "nsis": {
      "artifactName": "NCLEX-RN-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "NCLEX-RN-Portable-${version}.exe"
    }
  }
}
